# Готовые кадры и брак в репозиторий не кладём: он публичный, а кадры отдаются заказчику
# через 05_deliver рабочей директории.
03_images/
05_deliver/
# Прежняя редакция глушила `*.png` по всему дереву. Это шире, чем нужно: превью кадров в
# prompts/**/материалы и картинки набора в refs/ — тоже png, и такой файл молча не уезжал бы
# на GitHub, оставаясь только на маке. Глушим каталоги, а не расширение (Ф158).
03_images/**/*.png
05_deliver/**/*.png
# служебное
__pycache__/
*.pyc
.DS_Store
# Журнал наблюдаемости: репозиторий публичный, а события содержат коды кадров и имена файлов.
# Долговременное хранение — перенос сводки на мак, в ~/Developer/AI-STUDIO/obs/.
00_obs/events.jsonl
00_obs/events.jsonl.*
00_obs/state.json
00_obs/*.md
!00_obs/ЧТО_ЗДЕСЬ.md

# Перевалочные папки моста: файлы приезжают сюда и переносятся в комплект командой cat.
# В репозитории им делать нечего — 19.08 транзитные копии промптов и скриптов попали
# в коммит через _снято_с_учёта/ и стали побайтными дублями рабочих файлов (пункт 6в).
/_in/
/_снято_с_учёта/
# Пути якорные (со слеша в начале): refs/_снято_с_учёта/ и архивы промптов — часть
# комплекта и остаются в репозитории. Глушить имя каталога везде — это Ф158.

# Окружение замеров: ставится automation/setup.sh, у каждого своё, ~300 МБ.
/.venv/
